---
// Bookmarks component.
//
// The markup renders during the static build. All dynamic behaviour (adding a
// bookmark, generating its short slug, persisting to localStorage) lives in
// the client-side <script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only, never during the static
  // build, so localStorage is safe to touch here.
  import {
    STORAGE_KEY,
    normaliseUrl,
    nextSlug,
    parseStored,
    formatBookmark,
  } from '../lib/bookmarks.js';

  type Bookmark = { url: string; slug: string };

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const errorEl = document.getElementById('form-error');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  // ---------- storage (localStorage can throw in private modes / when full) ----------
  function load(): Bookmark[] {
    try {
      return parseStored(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(items: Bookmark[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch {
      showError('Could not save to this browser’s storage.');
    }
  }

  let bookmarks: Bookmark[] = load();

  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = !message;
    input?.setAttribute('aria-invalid', message ? 'true' : 'false');
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  }

  // ---------- rendering (textContent only — never innerHTML with user data) ----------
  function renderRow(b: Bookmark): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'bookmark';
    li.title = formatBookmark(b);

    const link = document.createElement('a');
    link.className = 'url';
    link.href = b.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = b.url;

    const sep = document.createElement('span');
    sep.className = 'sep';
    sep.textContent = ' :: ';

    const slug = document.createElement('code');
    slug.className = 'slug';
    slug.textContent = b.slug;

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'copy';
    copy.textContent = 'Copy';
    copy.setAttribute('aria-label', `Copy slug ${b.slug}`);
    copy.addEventListener('click', async () => {
      const ok = await copyText(b.slug);
      copy.textContent = ok ? 'Copied' : 'Copy failed';
      setTimeout(() => (copy.textContent = 'Copy'), 1500);
    });

    li.append(link, sep, slug, copy);
    return li;
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren(...bookmarks.map(renderRow));
    const hasItems = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasItems;
    if (listHeader) listHeader.hidden = !hasItems;
  }

  // ---------- events ----------
  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // first — a later error can never trigger a native reload
    try {
      const url = normaliseUrl(input?.value ?? '');
      if (!url) {
        showError('Enter a valid web address, e.g. https://example.com');
        input?.focus();
        return;
      }
      const existing = bookmarks.find((b) => b.url === url);
      if (existing) {
        showError(`Already saved as ${existing.slug}.`);
        return;
      }
      showError('');
      bookmarks = [{ url, slug: nextSlug(bookmarks.map((b) => b.slug)) }, ...bookmarks];
      save(bookmarks);
      render();
      form.reset();
      input?.focus();
    } catch {
      showError('Something went wrong saving that link — please try again.');
    }
  });

  input?.addEventListener('input', () => showError(''));

  clearAll?.addEventListener('click', () => {
    if (!bookmarks.length) return;
    if (!confirm('Remove all saved bookmarks from this browser?')) return;
    bookmarks = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* storage unavailable — in-memory list is already cleared */
    }
    render();
  });

  // Re-render saved bookmarks on page load so the list survives a reload.
  render();
</script>
